# Base URL of the Play Together API (v2 prefix included).
# Defaults to http://localhost:3000/api/v2 when unset.
# On a physical device use your machine's LAN IP, e.g. http://192.168.1.10:3000/api/v2
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v2

# Optional Google sign-in. Without this the Google button only shows a "not configured" hint.
# Must be the same "Web application" client ID that the API is given as GOOGLE_CLIENT_ID, and that
# client must list this app's dev server origin (http://localhost:8081) as an authorised redirect URI.
# Works in the browser and in Expo Go? Browser yes. Expo Go never completes Google sign-in, and on a
# development build this client ID alone is not enough — see docs/google-signin.md in the project
# root for the two device paths (native library, or an Android client ID + PKCE) before adding keys.
# Restart Metro after changing it — EXPO_PUBLIC_ values are baked into the bundle.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
