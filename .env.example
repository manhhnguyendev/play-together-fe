# Base URL of the Play Together API (v2 prefix included).
# Defaults to http://localhost:3000/api/v2 when unset.
# On a physical device use your machine's LAN IP, e.g. http://192.168.1.10:3000/api/v2
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v2

# Optional Google sign-in. Without these the Google button only shows a "not configured" hint.
#
# WEB client — used by the browser. Must be the same "Web application" client ID the API gets as
# GOOGLE_CLIENT_ID, and that client must list the app's dev server origin (http://localhost:8081)
# as an authorised redirect URI.
# Restart Metro after changing it — EXPO_PUBLIC_ values are baked into the bundle.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
#
# ANDROID / IOS client — needed for sign-in to work in a dev or production build. Create an OAuth
# client of type "Android" (package name com.playtogether.app + the SHA-1 of the keystore the build
# signs with) / "iOS" (bundle ID com.playtogether.app), and give the API the same values as
# GOOGLE_ANDROID_CLIENT_ID / GOOGLE_IOS_CLIENT_ID so it accepts those tokens.
# Setting these also changes the native project: app.config.ts registers the
# com.googleusercontent.apps.<id> return scheme, so a build made without them cannot receive the
# response. Expo Go never completes Google sign-in — the button says so there.
# Steps: docs/google-signin.md §6 in the project root.
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
