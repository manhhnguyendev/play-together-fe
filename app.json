{
  "expo": {
    "name": "Play Together",
    "slug": "play-together",
    "scheme": "playtogether",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_v2.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo_splash_v2.png",
          "dark": {
            "image": "./assets/images/logo_splash_v2.png",
            "backgroundColor": "#101219"
          },
          "imageWidth": 210
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần truy cập thư viện ảnh để cập nhật ảnh đại diện."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.playtogether.app"
    },
    "android": {
      "package": "com.playtogether.app",
      "adaptiveIcon": {
        "backgroundColor": "#EFECFF",
        "foregroundImage": "./assets/android-icon-foreground_v2.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    }
  }
}
